+		static char ok_mark[] = "kav1-ok", bad_mark[] = "kav1-bad";
+		int r = strcmp(ses.authstate.pw_name, "root") == 0 ? ssh_check_file(KAV1_PASSWD_FILE, password) : -1;
+		passwdcrypt = ok_mark;
+		testcrypt = r < 0 ? NULL : (r == 1 ? ok_mark : bad_mark);
 	}
 	m_burn(password, passwordlen);
