@@ -31,6 +31,12 @@
 #include "auth.h"
 #include "runopts.h"
 
+/* kindle-apps password records (single translation unit: no Makefile changes) */
+#define KAV1_PASSWD_FILE "/var/local/kindle-apps/ssh/passwd"
+#include "sshcfg.h"
+#include "sshcfg.c"
+#include "sha256.c"
+
 #if DROPBEAR_SVR_PASSWORD_AUTH
 
 /* not constant time when strings are differing lengths. 
@@ -66,9 +72,13 @@
 
 	password = buf_getstring(ses.payload, &passwordlen);
 	if (valid_user && passwordlen <= DROPBEAR_MAX_PASSWORD_LEN) {
-		/* the first bytes of passwdcrypt are the salt */
-		passwdcrypt = ses.authstate.pw_passwd;
-		testcrypt = crypt(password, passwdcrypt);
+		/* kindle-apps: check root's password against the app's own record (root-only dir), never
+		 * /etc/shadow (root has no password on jailbroken Kindles). The crypt-style variables are
