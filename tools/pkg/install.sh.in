#!/bin/sh
# Installs @NAME@ into the Uygulamalar menu; user data in /mnt/us/kindle-apps/data is untouched.
# No kpm dependency is declared (kpm 0.2.2 aborts while resolving uninstalled dependencies),
# so warn here when the core package is missing.
set -e
DEST=/mnt/us/kindle-apps/apps/@APPDIR@
[ -f ./pre-install.sh ] && sh ./pre-install.sh
mkdir -p "$DEST"
cp -f ./files/* ./app.ini "$DEST/"
for f in ./files/*; do chmod +x "$DEST/${f##*/}" 2>/dev/null || true; done
[ -f ./post-install.sh ] && sh ./post-install.sh
rm -rf ./files
[ -x /mnt/us/kindle-apps/bin/hub ] || echo "UYARI: önce kindle-apps-core paketini kurun (kpm install kindle-apps-core)"
exit 0
